{
  "name": "sharecheck",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "next build",
    "format": "prettier --write src tests scripts docs *.json *.md *.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
